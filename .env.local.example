# TalentFlow Environment Variables
# Copy this file to .env.local and fill in your values

# =====================================
# SUPABASE (Free Tier - 50K MAU)
# =====================================
# Get these from your Supabase Dashboard:
# Settings > API > Project URL and anon key
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# =====================================
# PAYMENTS (Razorpay/Stripe Test Mode - Free)
# =====================================
# Razorpay: https://dashboard.razorpay.com/app/test-keys
# Stripe: https://dashboard.stripe.com/test/apikeys
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=rzp_test_your_key_secret
STRIPE_SECRET_KEY=sk_test_your_stripe_secret

# =====================================
# APP CONFIG
# =====================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-a-random-string-here

# =====================================
# FIREBASE (for Sentinel monitoring)
# =====================================
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id
