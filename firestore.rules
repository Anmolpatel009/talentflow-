rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if a user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if the user is the one specified by a uid
    function isUser(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // Users can be created by anyone (for signup) but only modified by themselves.
    match /users/{userId} {
      allow read: if true;
      allow create: if true; 
      allow update: if isUser(userId);
      allow delete: if false;
    }

    // Tasks can be read by anyone, but only created by logged-in users.
    // The client who created the task can update or delete it.
    // Any authenticated user can increment the proposal count, but change nothing else.
    match /tasks/{taskId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update: if isUser(resource.data.clientUid) || 
                      (isAuthenticated() &&
                       request.resource.data.proposals == resource.data.proposals + 1 &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['proposals']));
      allow delete: if isUser(resource.data.clientUid);
    }

    // Proposals are a subcollection of tasks.
    match /tasks/{taskId}/proposals/{proposalId} {
      // A client can list all proposals for their own task.
      allow list: if isUser(get(/databases/$(database)/documents/tasks/$(taskId)).data.clientUid);
      
      // A freelancer can read their own proposal (to see if they applied).
      // The proposalId is the freelancer's uid.
      allow get: if isUser(proposalId);
      
      // A freelancer can create a proposal for any task. The proposalId must be their own UID.
      allow create: if isUser(proposalId);
      
      // No one can update or delete proposals through the client for now.
      allow update, delete: if false;
    }
  }
}
