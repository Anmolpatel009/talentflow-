rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users can be read by anyone (for profiles), but only updated by the owner.
    // Anyone can create a user account (signup).
    match /users/{userId} {
      allow read;
      allow create;
      allow update: if request.auth.uid == userId;
    }

    // Tasks can be read by anyone, but only created by logged-in users.
    match /tasks/{taskId} {
      allow read;
      allow create: if request.auth != null;

      // Rules for the proposals subcollection of a task.
      match /proposals/{userId} {
        // Allow a freelancer to check if they've already applied for a task.
        // This is a single-document read.
        allow get: if request.auth.uid == userId;
        
        // Allow the client who owns the task to read all proposals.
        // This is a collection read.
        allow list: if request.auth.uid == get(/databases/$(database)/documents/tasks/$(taskId)).data.clientUid;

        // Allow a freelancer to create their own proposal document.
        allow create: if request.auth.uid == userId;
      }
    }
  }
}
