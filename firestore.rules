rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if a user is authenticated via our custom JWT
    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    // Allow anyone to read any document in the database.
    // This simplifies displaying profiles, tasks, etc., during development.
    match /{document=**} {
      allow read: if true;
    }

    // Rules for the 'users' collection
    match /users/{userId} {
      // Anyone can create a user account (for signing up).
      allow create: if true;
      
      // Only the authenticated owner of the document can update or delete it.
      allow update, delete: if isAuthenticated() && request.auth.uid == userId;
    }

    // Rules for the 'tasks' collection and its subcollections
    match /tasks/{taskId} {
      // Any authenticated user can create, update, or delete tasks.
      // This is permissive for development and solves the "permission denied" error.
      // We can tighten this later to be owner-only.
      allow write: if isAuthenticated();

      // Rules for the 'proposals' subcollection
      match /proposals/{proposalId} {
        // Any authenticated user can create a proposal.
        allow write: if isAuthenticated();
      }
    }
  }
}
