rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Allow public read access to users and tasks.
    // Writes are restricted.
    match /users/{userId} {
      allow read;
      // Anyone can create a user document (signup).
      allow create;
      // Only the authenticated user can update their own document.
      allow update: if request.auth != null && request.auth.uid == userId;
    }

    match /tasks/{taskId} {
      allow read;
      
      // Allow task creation only for authenticated users where the UID matches.
      allow create: if request.auth != null && request.resource.data.clientUid == request.auth.uid;
      
      // Allow the task owner to update any part of the task.
      // Allow any authenticated user to ONLY increment the proposals counter.
      allow update: if request.auth != null && (
        (resource.data.clientUid == request.auth.uid) ||
        (
          request.resource.data.proposals == resource.data.proposals + 1 &&
          // Ensure ONLY the proposals field is being changed.
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['proposals'])
        )
      );
    }
    
    // Proposals subcollection rules
    match /tasks/{taskId}/proposals/{freelancerUid} {
      // Allow a freelancer to create their own proposal document.
      allow create: if request.auth != null && request.auth.uid == freelancerUid;
      
      // Allow a freelancer to check if they have already applied.
      allow get: if request.auth != null && request.auth.uid == freelancerUid;

      // Allow the client who owns the task to list all proposals.
      allow list: if request.auth != null && get(/databases/$(database)/documents/tasks/$(taskId)).data.clientUid == request.auth.uid;
    }
  }
}
