rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if a user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if the user is the owner of a document by their UID
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // Users can be read by anyone.
    // Users can create their own profile (signup).
    // Users can only update their own profile.
    match /users/{userId} {
      allow read: if true;
      allow create: if true; 
      allow update: if isOwner(userId);
    }
    
    // Tasks can be read by anyone.
    // Tasks can only be created by logged-in users.
    // Tasks can only be updated/deleted by the client who created them.
    match /tasks/{taskId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isOwner(resource.data.clientUid);

      // Proposals subcollection
      match /proposals/{proposalId} { // proposalId is now the freelancer's uid
        // Allow create if the user is authenticated AND they are creating their own proposal document
        allow create: if isAuthenticated() && request.auth.uid == proposalId;
        
        // Allow a freelancer to read their own proposal (to check if they've applied)
        // Allow the task owner to read all proposals
        allow read: if (isAuthenticated() && request.auth.uid == proposalId) || isOwner(get(/databases/$(database)/documents/tasks/$(taskId)).data.clientUid);
        
        // Allow the task owner to list all proposals
        allow list: if isOwner(get(/databases/$(database)/documents/tasks/$(taskId)).data.clientUid);
      }
    }
  }
}
