
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Users can be read by anyone (for profiles), but only the user can write.
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth.uid == userId;
    }

    // Tasks can be read by anyone, created by any logged-in user,
    // and deleted only by the owner.
    match /tasks/{taskId} {
      allow read: if true;
      allow create: if request.auth.uid != null;
      allow delete: if resource.data.clientUid == request.auth.uid;

      // Update logic:
      // 1. The owner of the task can update any field.
      // 2. Any authenticated user can apply, which is a specific update that
      //    only increments the 'proposals' count and changes no other fields.
      allow update: if (resource.data.clientUid == request.auth.uid) ||
                     (
                       request.auth.uid != null &&
                       request.resource.data.proposals == resource.data.proposals + 1 &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['proposals'])
                     );

      // Proposals are a subcollection of tasks.
      match /proposals/{freelancerId} {
        // A freelancer can read their own proposal.
        // The client who owns the task can read all proposals for that task.
        allow read: if request.auth.uid == freelancerId || get(/databases/$(database)/documents/tasks/$(taskId)).data.clientUid == request.auth.uid;
        
        // A freelancer can create their own proposal. They cannot edit or delete it after.
        allow create: if request.auth.uid == freelancerId;
        allow update, delete: if false; // Proposals are final once submitted.
      }
    }
  }
}
