
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Users can be seen by anyone, but only created during signup.
    // For this prototype, users cannot update or delete profiles.
    match /users/{userId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if false; 
    }

    // Tasks can be seen by anyone.
    // Only authenticated users can create or apply to (update) tasks.
    match /tasks/{taskId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if false;
    }
  }
}
