rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if a user is authenticated
    function isSignedIn() {
      return request.auth != null;
    }

    // Helper function to check if the user is the owner of a document
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // Users can create their own profile, but only update their own.
    // Public can view profiles.
    match /users/{userId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isOwner(userId);
    }

    // Tasks can be read by anyone.
    // Only signed-in users can create tasks.
    // Only the task owner can update the task details, except for the proposal count.
    match /tasks/{taskId} {
      allow read: if true;
      allow create: if isSignedIn();
      
      // Allow an update if the user is the owner OR if they are only incrementing the proposal count by 1
      allow update: if isOwner(resource.data.clientUid) || 
                      (
                        isSignedIn() &&
                        request.resource.data.proposals == resource.data.proposals + 1 &&
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['proposals'])
                      );
    }
    
    // Proposals are subcollections of tasks.
    match /tasks/{taskId}/proposals/{proposalId} {
      // Only the task owner can list all proposals.
      allow list: if get(/databases/$(database)/documents/tasks/$(taskId)).data.clientUid == request.auth.uid;
      
      // An authenticated user can create their own proposal using their UID as the document ID.
      allow create: if isSignedIn() && request.auth.uid == proposalId;
      
      // A freelancer can see their own proposal, and the client can see all of them.
      allow get: if (isSignedIn() && request.auth.uid == proposalId) || 
                   (get(/databases/$(database)/documents/tasks/$(taskId)).data.clientUid == request.auth.uid);
    }
  }
}